# Required for signed Web session cookies.
# Generate a random value with at least 32 characters, for example:
#   openssl rand -base64 48
CLINIC_CLOUD_SESSION_SECRET=
PUBLIC_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
CLINIC_CLOUD_STAFF_MCP_SECRET=replace-with-at-least-32-characters
STAFF_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
CLINIC_CLOUD_HANDOFF_SECRET=replace-with-at-least-32-characters